# Runtime
NODE_ENV=development
TZ=Asia/Tashkent
PORT=3000

# Telegram bot
TOKEN=your_telegram_bot_token_here
BOT_NAME=YourBotName
BOT_TYPE=B2C
BOT_USERNAME=YourBotUsername
WEBHOOK_URL=https://yourdomain.com
RENDER_EXTERNAL_URL=https://your-render-service.onrender.com
JOIN_LINK=https://t.me/your_channel_or_group

# External web/app
WEB_PAGE_URL=https://yourdomain.com/

# Backend API
API_URL=https://api.yourdomain.com/api
API_SECRET=your_api_secret_key_here

# Payments
PAYME_URL=https://checkout.paycom.uz/
PAYME_MERCHAND_ID=your_payme_merchant_id

# Media / OSS
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket

# Telegram media ids
START_VIDEO_FILE_ID=your_start_video_file_id
REGISTER_VIDEO_FILE_ID=your_register_video_file_id

# Feedback
FEEDBACK_GROUP_ID=-1000000000000

# Media/OCR safety limits
MAX_MEDIA_SIZE_MB=20
PDF_MAX_PAGES=30
XLSX_MAX_ROWS=5000
MAX_OCR_TEXT_CHARS=100000

# Legacy Supabase REST vars (only if src/apis/apiClient.js still uses Supabase REST)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_API_KEY=your_supabase_api_key
